{
  "$defs": {
    "Apontamento": {
      "additionalProperties": false,
      "properties": {
        "codigo_original": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Codigo Original",
          "type": "string"
        },
        "namespace_formato": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Namespace Formato",
          "type": "string"
        },
        "origem": {
          "$ref": "#/$defs/Origem"
        }
      },
      "required": [
        "codigo_original",
        "namespace_formato",
        "origem"
      ],
      "title": "Apontamento",
      "type": "object"
    },
    "Boleto": {
      "additionalProperties": false,
      "properties": {
        "apontamentos": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Apontamento"
          },
          "title": "Apontamentos",
          "type": "array"
        },
        "competencia": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Competencia"
        },
        "composicao": {
          "$ref": "#/$defs/Composicao"
        },
        "condominio_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Condominio Id",
          "type": "string"
        },
        "correcao": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correcao"
        },
        "emissao": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emissao"
        },
        "emissao_original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emissao Original"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "identificador": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Identificador",
          "type": "string"
        },
        "juros": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Juros"
        },
        "multa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Multa"
        },
        "origens": {
          "items": {
            "$ref": "#/$defs/Origem"
          },
          "minItems": 1,
          "title": "Origens",
          "type": "array"
        },
        "saldo_acumulado": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saldo Acumulado"
        },
        "unidade_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Unidade Id",
          "type": "string"
        },
        "vencimento": {
          "format": "date",
          "title": "Vencimento",
          "type": "string"
        }
      },
      "required": [
        "id",
        "condominio_id",
        "unidade_id",
        "identificador",
        "vencimento",
        "composicao",
        "origens"
      ],
      "title": "Boleto",
      "type": "object"
    },
    "CampoAusente": {
      "additionalProperties": false,
      "properties": {
        "campo": {
          "title": "Campo",
          "type": "string"
        },
        "registro_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Registro Id",
          "type": "string"
        }
      },
      "required": [
        "registro_id",
        "campo"
      ],
      "title": "CampoAusente",
      "type": "object"
    },
    "CandidatoReconciliado": {
      "additionalProperties": false,
      "properties": {
        "ambiente": {
          "enum": [
            "sintetico",
            "privado"
          ],
          "title": "Ambiente",
          "type": "string"
        },
        "catalogos": {
          "items": {
            "$ref": "#/$defs/CatalogoImpedimentos"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Catalogos",
          "type": "array"
        },
        "condominio_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Condominio Id",
          "type": "string"
        },
        "entrada": {
          "$ref": "#/$defs/EntradaSimulacao"
        },
        "fontes": {
          "items": {
            "$ref": "#/$defs/FontePrivada"
          },
          "minItems": 1,
          "title": "Fontes",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "inventario": {
          "$ref": "#/$defs/InventarioReconciliado"
        },
        "reconciliacao": {
          "$ref": "#/$defs/ReconciliacaoOcorrencias"
        },
        "schema_version": {
          "const": "1.1",
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "condominio_id",
        "ambiente",
        "entrada",
        "catalogos",
        "fontes",
        "inventario",
        "reconciliacao"
      ],
      "title": "CandidatoReconciliado",
      "type": "object"
    },
    "CatalogoImpedimentos": {
      "additionalProperties": false,
      "description": "Vazio é um resultado revisado, nunca o default de falha de carregamento.",
      "properties": {
        "categoria": {
          "enum": [
            "leitura",
            "auditoria_lote",
            "titularidade",
            "documentos"
          ],
          "title": "Categoria",
          "type": "string"
        },
        "condominio_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Condominio Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "ocorrencias": {
          "items": {
            "$ref": "#/$defs/Ocorrencia"
          },
          "title": "Ocorrencias",
          "type": "array"
        },
        "origens": {
          "items": {
            "$ref": "#/$defs/Origem"
          },
          "minItems": 1,
          "title": "Origens",
          "type": "array"
        }
      },
      "required": [
        "id",
        "categoria",
        "condominio_id",
        "ocorrencias",
        "origens"
      ],
      "title": "CatalogoImpedimentos",
      "type": "object"
    },
    "CoberturaApontamentos": {
      "additionalProperties": false,
      "description": "Evidência explícita de completude de um campo/namespace, não um default.",
      "properties": {
        "boleto_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Boleto Id",
          "type": "string"
        },
        "namespace": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Namespace",
          "type": "string"
        },
        "origens": {
          "items": {
            "$ref": "#/$defs/Origem"
          },
          "minItems": 1,
          "title": "Origens",
          "type": "array"
        }
      },
      "required": [
        "boleto_id",
        "namespace",
        "origens"
      ],
      "title": "CoberturaApontamentos",
      "type": "object"
    },
    "Composicao": {
      "additionalProperties": false,
      "properties": {
        "itens": {
          "items": {
            "$ref": "#/$defs/ItemComposicao"
          },
          "minItems": 1,
          "title": "Itens",
          "type": "array"
        },
        "total_original": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Total Original"
        }
      },
      "required": [
        "itens",
        "total_original"
      ],
      "title": "Composicao",
      "type": "object"
    },
    "Contato": {
      "additionalProperties": false,
      "properties": {
        "emails": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Emails",
          "type": "array"
        },
        "endereco": {
          "$ref": "#/$defs/Endereco"
        },
        "origem": {
          "anyOf": [
            {
              "$ref": "#/$defs/Origem"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "telefones": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Telefone"
          },
          "maxItems": 5,
          "title": "Telefones",
          "type": "array"
        }
      },
      "title": "Contato",
      "type": "object"
    },
    "Documento": {
      "additionalProperties": false,
      "description": "Valor bruto textual; a validade fiscal é avaliada sem apagar evidências inválidas.",
      "properties": {
        "tipo": {
          "enum": [
            "cpf",
            "cnpj",
            "outro"
          ],
          "title": "Tipo",
          "type": "string"
        },
        "valor": {
          "description": "CPF/CNPJ bruto como texto, preservando zeros iniciais.",
          "title": "Valor",
          "type": "string"
        }
      },
      "required": [
        "tipo",
        "valor"
      ],
      "title": "Documento",
      "type": "object"
    },
    "Endereco": {
      "additionalProperties": false,
      "properties": {
        "bairro": {
          "default": "",
          "title": "Bairro",
          "type": "string"
        },
        "cep": {
          "default": "",
          "pattern": "^(\\d{8})?$",
          "title": "Cep",
          "type": "string"
        },
        "cidade": {
          "default": "",
          "title": "Cidade",
          "type": "string"
        },
        "complemento": {
          "default": "",
          "title": "Complemento",
          "type": "string"
        },
        "logradouro": {
          "default": "",
          "title": "Logradouro",
          "type": "string"
        },
        "numero": {
          "default": "",
          "title": "Numero",
          "type": "string"
        },
        "uf": {
          "default": "",
          "pattern": "^([A-Z]{2})?$",
          "title": "Uf",
          "type": "string"
        }
      },
      "title": "Endereco",
      "type": "object"
    },
    "EntradaSimulacao": {
      "additionalProperties": false,
      "properties": {
        "coberturas_apontamentos": {
          "items": {
            "$ref": "#/$defs/CoberturaApontamentos"
          },
          "title": "Coberturas Apontamentos",
          "type": "array"
        },
        "fatos": {
          "items": {
            "$ref": "#/$defs/FatoEvidenciado"
          },
          "title": "Fatos",
          "type": "array"
        },
        "lote": {
          "$ref": "#/$defs/LoteCanonico"
        },
        "ocorrencias_anteriores": {
          "items": {
            "$ref": "#/$defs/Ocorrencia"
          },
          "title": "Ocorrencias Anteriores",
          "type": "array"
        }
      },
      "required": [
        "lote",
        "fatos",
        "ocorrencias_anteriores",
        "coberturas_apontamentos"
      ],
      "title": "EntradaSimulacao",
      "type": "object"
    },
    "EvidenciaDocumento": {
      "additionalProperties": false,
      "properties": {
        "documento": {
          "$ref": "#/$defs/Documento"
        },
        "origem": {
          "$ref": "#/$defs/Origem"
        },
        "titular_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Titular Id"
        }
      },
      "required": [
        "documento",
        "origem"
      ],
      "title": "EvidenciaDocumento",
      "type": "object"
    },
    "FatoEvidenciado": {
      "additionalProperties": false,
      "properties": {
        "boleto_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boleto Id"
        },
        "condominio_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Condominio Id",
          "type": "string"
        },
        "confirmacao": {
          "enum": [
            "comprovado",
            "nao_confirmado"
          ],
          "title": "Confirmacao",
          "type": "string"
        },
        "fato_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Fato Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "origens": {
          "items": {
            "$ref": "#/$defs/Origem"
          },
          "minItems": 1,
          "title": "Origens",
          "type": "array"
        },
        "unidade_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Unidade Id",
          "type": "string"
        },
        "valor": {
          "discriminator": {
            "mapping": {
              "booleano": "#/$defs/ValorBooleano",
              "data": "#/$defs/ValorData",
              "dinheiro": "#/$defs/ValorDinheiro",
              "inteiro": "#/$defs/ValorInteiro",
              "texto": "#/$defs/ValorTexto"
            },
            "propertyName": "tipo"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ValorTexto"
            },
            {
              "$ref": "#/$defs/ValorInteiro"
            },
            {
              "$ref": "#/$defs/ValorDinheiro"
            },
            {
              "$ref": "#/$defs/ValorBooleano"
            },
            {
              "$ref": "#/$defs/ValorData"
            }
          ],
          "title": "Valor"
        },
        "vigente_ate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vigente Ate"
        },
        "vigente_de": {
          "format": "date",
          "title": "Vigente De",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fato_id",
        "condominio_id",
        "unidade_id",
        "valor",
        "vigente_de",
        "confirmacao",
        "origens"
      ],
      "title": "FatoEvidenciado",
      "type": "object"
    },
    "FonteHistorico": {
      "additionalProperties": false,
      "properties": {
        "arquivo": {
          "$ref": "#/$defs/FontePrivada"
        },
        "estrutura": {
          "enum": [
            "lista_ocorrencias",
            "casos_documentais"
          ],
          "title": "Estrutura",
          "type": "string"
        },
        "namespace": {
          "enum": [
            "operacional",
            "documental"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "produtor_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Produtor Id",
          "type": "string"
        },
        "produtor_versao": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Produtor Versao",
          "type": "string"
        }
      },
      "required": [
        "arquivo",
        "namespace",
        "produtor_id",
        "produtor_versao",
        "estrutura"
      ],
      "title": "FonteHistorico",
      "type": "object"
    },
    "FontePrivada": {
      "additionalProperties": false,
      "properties": {
        "arquivo_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Arquivo Id",
          "type": "string"
        },
        "caminho": {
          "minLength": 1,
          "title": "Caminho",
          "type": "string"
        },
        "papel": {
          "enum": [
            "inadimplencia",
            "cadastro",
            "referencia",
            "requisitos",
            "evidencia"
          ],
          "title": "Papel",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "tamanho": {
          "minimum": 1,
          "title": "Tamanho",
          "type": "integer"
        }
      },
      "required": [
        "arquivo_id",
        "caminho",
        "sha256",
        "tamanho",
        "papel"
      ],
      "title": "FontePrivada",
      "type": "object"
    },
    "Gravidade": {
      "enum": [
        "informativo",
        "alerta",
        "critico"
      ],
      "title": "Gravidade",
      "type": "string"
    },
    "InventarioReconciliado": {
      "additionalProperties": false,
      "properties": {
        "apontamentos": {
          "minimum": 0,
          "title": "Apontamentos",
          "type": "integer"
        },
        "campos_ausentes": {
          "items": {
            "$ref": "#/$defs/CampoAusente"
          },
          "title": "Campos Ausentes",
          "type": "array"
        },
        "hash_entrada": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash Entrada",
          "type": "string"
        },
        "itens_composicao": {
          "minimum": 0,
          "title": "Itens Composicao",
          "type": "integer"
        },
        "origens": {
          "items": {
            "$ref": "#/$defs/Origem"
          },
          "minItems": 1,
          "title": "Origens",
          "type": "array"
        },
        "reconciliacao_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reconciliacao Hash",
          "type": "string"
        },
        "registros": {
          "items": {
            "$ref": "#/$defs/RegistroInventariado"
          },
          "title": "Registros",
          "type": "array"
        }
      },
      "required": [
        "hash_entrada",
        "registros",
        "apontamentos",
        "itens_composicao",
        "origens",
        "campos_ausentes",
        "reconciliacao_hash"
      ],
      "title": "InventarioReconciliado",
      "type": "object"
    },
    "ItemComposicao": {
      "additionalProperties": false,
      "properties": {
        "codigo": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Codigo",
          "type": "string"
        },
        "descricao_original": {
          "default": "",
          "title": "Descricao Original",
          "type": "string"
        },
        "origem": {
          "$ref": "#/$defs/Origem"
        },
        "valor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Valor"
        }
      },
      "required": [
        "codigo",
        "valor",
        "origem"
      ],
      "title": "ItemComposicao",
      "type": "object"
    },
    "LocalizacaoHistorica": {
      "additionalProperties": false,
      "properties": {
        "arquivo_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Arquivo Id",
          "type": "string"
        },
        "arquivo_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Arquivo Sha256",
          "type": "string"
        },
        "namespace": {
          "enum": [
            "operacional",
            "documental"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "ponteiro_json": {
          "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$",
          "title": "Ponteiro Json",
          "type": "string"
        },
        "produtor_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Produtor Id",
          "type": "string"
        },
        "produtor_versao": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Produtor Versao",
          "type": "string"
        }
      },
      "required": [
        "arquivo_id",
        "arquivo_sha256",
