{
  "$id": "urn:conversor:auditoria:1.0:recibo",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ambiente": {
      "enum": [
        "sintetico",
        "privado"
      ],
      "title": "Ambiente",
      "type": "string"
    },
    "assinatura": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Assinatura",
      "type": "string"
    },
    "condominio_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Condominio Id",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "politica_autorizacao_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Politica Autorizacao Hash",
      "type": "string"
    },
    "raiz_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raiz Hash",
      "type": "string"
    },
    "repositorio_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Repositorio Id",
      "type": "string"
    },
    "responsavel_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Responsavel Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "tipo": {
      "const": "reconciliacao",
      "default": "reconciliacao",
      "title": "Tipo",
      "type": "string"
    }
  },
  "required": [
    "repositorio_id",
    "raiz_hash",
    "id",
    "condominio_id",
    "ambiente",
    "sha256",
    "responsavel_id",
    "politica_autorizacao_hash",
    "assinatura"
  ],
  "title": "ReciboReconciliacao",
  "type": "object"
}
