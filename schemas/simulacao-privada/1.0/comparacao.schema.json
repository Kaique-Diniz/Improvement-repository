  "$id": "urn:conversor:simulacao-privada:1.0:comparacao",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ambiente": {
      "enum": [
        "sintetico",
        "privado"
      ],
