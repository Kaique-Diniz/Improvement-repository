      "type": "string"
    },
    "autoriza_cobranca": {
      "const": false,
      "default": false,
      "title": "Autoriza Cobranca",
      "type": "boolean"
    },
    "cobertura_referencia_completa": {
      "title": "Cobertura Referencia Completa",
      "type": "boolean"
    },
    "colunas": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "minItems": 30,
      "title": "Colunas",
      "type": "array"
    },
    "colunas_nao_avaliadas": {
      "items": {
        "type": "string"
      },
      "title": "Colunas Nao Avaliadas",
      "type": "array"
    },
    "comparador_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Comparador Hash",
      "type": "string"
    },
    "comparador_versao": {
      "const": "4.3A.0",
      "default": "4.3A.0",
      "title": "Comparador Versao",
      "type": "string"
    },
    "condominio_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Condominio Id",
      "type": "string"
    },
    "divergencias": {
      "items": {
        "$ref": "#/$defs/DivergenciaSimulacao"
      },
      "title": "Divergencias",
      "type": "array"
    },
    "execucao_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execucao Hash",
      "type": "string"
    },
    "execucao_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Execucao Id",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "mapeamento": {
      "$ref": "#/$defs/MapeamentoReferencia"
    },
    "permite_exportacao_operacional": {
      "const": false,
      "default": false,
      "title": "Permite Exportacao Operacional",
      "type": "boolean"
    },
    "referencia_e_gabarito_absoluto": {
      "const": false,
      "default": false,
      "title": "Referencia E Gabarito Absoluto",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "template": {
      "$ref": "#/$defs/Template"
    }
  },
  "required": [
    "id",
    "condominio_id",
    "ambiente",
    "execucao_id",
    "execucao_hash",
    "comparador_hash",
    "template",
    "mapeamento",
    "divergencias",
    "colunas",
    "colunas_nao_avaliadas",
    "cobertura_referencia_completa"
  ],
  "title": "ComparacaoPrivada",
  "type": "object"
}
