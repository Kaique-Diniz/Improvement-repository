          "title": "Fatos",
          "type": "array"
        },
        "fontes": {
          "items": {
            "$ref": "#/$defs/Origem"
          },
          "minItems": 1,
          "title": "Fontes",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "natureza": {
          "enum": [
            "sintetico",
            "operacional"
          ],
          "title": "Natureza",
          "type": "string"
        },
        "politicas": {
          "$ref": "#/$defs/PoliticasCobranca"
        },
        "regras": {
          "items": {
            "$ref": "#/$defs/ClausulaCobranca"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Regras",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "versao": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Versao",
          "type": "string"
        },
        "vigente_ate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vigente Ate"
        },
        "vigente_de": {
          "format": "date",
          "title": "Vigente De",
          "type": "string"
        }
      },
      "required": [
        "id",
        "condominio_id",
        "versao",
        "natureza",
        "vigente_de",
        "fontes",
        "regras"
      ],
      "title": "PlanoCobranca",
      "type": "object"
    },
    "PoliticasCobranca": {
      "additionalProperties": false,
      "properties": {
        "bloqueios_criticos": {
