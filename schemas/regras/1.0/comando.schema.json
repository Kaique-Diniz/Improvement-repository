          "type": "string"
        },
        "alvo": {
          "enum": [
            "unidade",
            "boleto"
          ],
          "title": "Alvo",
          "type": "string"
        },
        "fonte_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Fonte Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "motivo_codigo": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Motivo Codigo",
          "type": "string"
        },
        "prioridade": {
          "minimum": 0,
          "title": "Prioridade",
          "type": "integer"
        },
        "quando": {
          "discriminator": {
            "mapping": {
              "apontamento": "#/$defs/PredicadoApontamento",
              "dias_atraso": "#/$defs/PredicadoDias",
              "existe_boleto": "#/$defs/ExisteBoleto",
              "fato": "#/$defs/PredicadoFato",
              "nao": "#/$defs/Nao",
              "qualquer": "#/$defs/Qualquer",
              "todas": "#/$defs/Todas",
              "todos_boletos": "#/$defs/TodosBoletos",
              "valor_original": "#/$defs/PredicadoValor"
            },
            "propertyName": "tipo"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PredicadoDias"
            },
            {
              "$ref": "#/$defs/PredicadoValor"
            },
            {
              "$ref": "#/$defs/PredicadoApontamento"
            },
            {
              "$ref": "#/$defs/PredicadoFato"
            },
            {
              "$ref": "#/$defs/Todas"
            },
            {
              "$ref": "#/$defs/Qualquer"
            },
            {
              "$ref": "#/$defs/Nao"
            },
            {
              "$ref": "#/$defs/ExisteBoleto"
            },
            {
              "$ref": "#/$defs/TodosBoletos"
            }
          ],
          "title": "Quando"
        }
      },
      "required": [
        "id",
        "prioridade",
        "alvo",
        "quando",
        "acao",
        "motivo_codigo",
        "fonte_id"
      ],
      "title": "ClausulaCobranca",
      "type": "object"
    },
